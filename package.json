{
  "name": "quiz-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live quiz: hosted games, question bank, event history.",
  "scripts": {
    "dev": "firebase emulators:start --project demo-quiz-arena",
    "test": "node --test tests/core.test.mjs",
    "test:rules": "firebase emulators:exec --only database,auth --project demo-quiz-arena \"node --test tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --project demo-quiz-arena \"node tests/e2e.mjs\"",
    "check:questions": "node tools/check-questions.mjs",
    "vendor": "node tools/vendor-libs.mjs",
    "play": "firebase emulators:exec --project demo-quiz-arena \"node tools/play-local.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "playwright": "^1.65.0"
  }
}
